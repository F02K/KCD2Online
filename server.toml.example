[server]
bind_address = "0.0.0.0"
port = 27020
name = "KCD2Online Server"
password = ""
max_players = 8
# 2 = trosecko, 3 = kutnohorsko, 4 = klaster
level_id = "3"
required_content_hash = ""
tick_rate = 30
snapshot_rate = 20
handshake_timeout_seconds = 10
idle_timeout_seconds = 15
reconnect_grace_seconds = 30
bootstrap_timeout_seconds = 180
profile_snapshot_interval_seconds = 15
disable_human_npcs = false
disable_animal_npcs = false
default_avatar_archetype = "763db0bb-4469-497d-bdc9-712b3df91b5a"
allowed_avatar_archetypes = ["763db0bb-4469-497d-bdc9-712b3df91b5a"]
max_player_speed_mps = 15.0
movement_tolerance_m = 2.0
world_directory = "world"
starter_profile = "starter_profile.toml"

[auth]
enabled = true
# When enabled, regular accounts must have a centrally managed membership
# with whitelisted=true. Network staff still retain their join bypass.
whitelist_enabled = false
service_url = "https://api.kingdom-online.cc"
# Created automatically on first start. Keep this file to retain the stable ID.
identity_file = "server-identity.json"
# Public UDP endpoint advertised by the browser. This is the only network value
# a community host must set; players never enter it themselves.
public_address = ""

[property]
# Directory produced by KCD2OnlineGameDataGenerator.exe. On the first start of a
# world, the server imports property_catalog_<level_id>.pb and keeps a copy in
# world_directory. Relative paths are resolved next to this configuration file.
game_data = "game_data"

[environment]
# Server-authoritative normal day cycle. The default ratio is 15 game seconds
# per real second, matching the retail game's normal time speed.
initial_time_of_day_hours = 8.0
time_scale = 15.0
weather_id = 1
weather_transition_seconds = 30
# Number of connected players that must be in a bed before the shared clock
# advances. The effective requirement is capped at the online player count.
sleeping_players_required = 1
sleep_wake_hour = 6.0

[chat]
# In-character speech is routed by authoritative server position. /ooc remains
# global unless explicitly disabled.
whisper_range_m = 3.0
say_range_m = 15.0
shout_range_m = 40.0
ooc_enabled = true

[voice]
# Proximity VOIP is relayed only to players inside the authoritative range.
# Clients transmit one Opus packet every 20 ms while push-to-talk is held.
enabled = true
whisper_range_m = 3.0
normal_range_m = 15.0
shout_range_m = 40.0
max_frames_per_second = 60

[permissions]
# KCD2Online account IDs shown by the server's `players` command. While central
# authentication is enabled, these owner claims and their history are reported
# to the authenticated backend. Configured owners and centrally authenticated
# network admins/owners implicitly receive `*`; all other grants are persisted
# in world/permissions.json.
owners = []

# Optional. If omitted, the first authenticated client initializes the spawn.
# [server.initial_spawn]
# x = 0.0
# y = 0.0
# z = 0.0
# qx = 0.0
# qy = 0.0
# qz = 0.0
# qw = 1.0
