// clang-format off

#include <winver.h>

1 VERSIONINFO
FILEVERSION         @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION      @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK       VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS           VS_FF_DEBUG
#else
FILEFLAGS           0x0L
#endif
FILEOS              VOS_NT_WINDOWS32
FILETYPE            VFT_DLL
FILESUBTYPE         0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KCD2Online\0"
            VALUE "FileDescription",  "Multiplayer framework for Kingdom Come: Deliverance II\0"
            VALUE "InternalName",     "d3d12\0"
            VALUE "OriginalFilename", "d3d12.dll\0"
            VALUE "ProductName",      "KCD2Online\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// clang-format on
